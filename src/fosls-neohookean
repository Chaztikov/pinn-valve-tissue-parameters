import tensorflow as tf
import deepxde as dde

# ==============================================================================
# 1. FOSLS PDE Definition
# ==============================================================================
def pde_fosls(x, y):
    """
    FOSLS formulation for Hyperelasticity (Neo-Hookean).
    
    Variables:
    x: Spatial coordinates (x, y, z)
    y: Network output [u, v, w, P11, P12, P13, P21, P22, P23, P31, P32, P33]
       - Indices 0-2: Displacement vector u
       - Indices 3-11: First Piola-Kirchhoff Stress Tensor P (flattened)
    """
    
    # --- A. Unpack Neural Network Outputs ---
    u_vec = y[:, 0:3]
    P_flat = y[:, 3:12]
    P_tensor = tf.reshape(P_flat, (-1, 3, 3)) # Shape: (Batch, 3, 3)

    # --- B. Kinematics: Compute Deformation Gradient F = I + grad(u) ---
    # We use Automatic Differentiation to get first derivatives of u
    du_x = dde.grad.jacobian(y, x, i=0, j=0)
    du_y = dde.grad.jacobian(y, x, i=0, j=1)
    du_z = dde.grad.jacobian(y, x, i=0, j=2)
    
    dv_x = dde.grad.jacobian(y, x, i=1, j=0)
    dv_y = dde.grad.jacobian(y, x, i=1, j=1)
    dv_z = dde.grad.jacobian(y, x, i=1, j=2)
    
    dw_x = dde.grad.jacobian(y, x, i=2, j=0)
    dw_y = dde.grad.jacobian(y, x, i=2, j=1)
    dw_z = dde.grad.jacobian(y, x, i=2, j=2)

    # Construct F (Identity + gradients)
    # Note: We construct it explicitly to maintain the graph connections
    row1 = tf.stack([1.0 + du_x, du_y, du_z], axis=2)
    row2 = tf.stack([dv_x, 1.0 + dv_y, dv_z], axis=2)
    row3 = tf.stack([dw_x, dw_y, 1.0 + dw_z], axis=2)
    F = tf.stack([row1, row2, row3], axis=1) # Shape: (Batch, 3, 3)

    # --- C. Constitutive Law (Neo-Hookean) ---
    # Model: Compressible Neo-Hookean
    # Psi = C1 * (I1 - 3) + D1 * (J - 1)^2
    # P = dPsi/dF = 2*C1*F + 2*D1*(J-1)*J*F^(-T)
    
    # Material Parameters (Ensure these match your global variable names)
    # Using generic names here; replace with your dde.Variable() if performing inversion
    # C1_val = C1 
    # D1_val = D1 
    
    J = tf.linalg.det(F)
    F_inv_T = tf.linalg.inv(tf.transpose(F, perm=[0, 2, 1])) # Inverse Transpose
    
    # Term 1: 2 * C1 * F
    term1 = 2.0 * C1 * F
    
    # Term 2: 2 * D1 * (J - 1) * J * F^-T
    # Note: dJ/dF = J * F^-T
    # d((J-1)^2)/dF = 2(J-1) * dJ/dF = 2(J-1) * J * F^-T
    J_expanded = J[:, None, None] # Expand dims for broadcasting
    term2 = 2.0 * D1 * (J_expanded - 1.0) * J_expanded * F_inv_T
    
    P_exact = term1 + term2
    
    # RESIDUAL 1: Constitutive Mismatch (P_NN - P_Model)
    res_constitutive = P_tensor - P_exact
    res_constitutive_flat = tf.reshape(res_constitutive, (-1, 9))

    # --- D. Momentum Balance: div(P) = 0 ---
    # We take the divergence of the PREDICTED stress P (outputs 3-11)
    # div(P)_i = dP_ij / dx_j
    
    # x-momentum
    dP11_dx = dde.grad.jacobian(y, x, i=3, j=0)
    dP12_dy = dde.grad.jacobian(y, x, i=4, j=1)
    dP13_dz = dde.grad.jacobian(y, x, i=5, j=2)
    mom_x = dP11_dx + dP12_dy + dP13_dz

    # y-momentum
    dP21_dx = dde.grad.jacobian(y, x, i=6, j=0)
    dP22_dy = dde.grad.jacobian(y, x, i=7, j=1)
    dP23_dz = dde.grad.jacobian(y, x, i=8, j=2)
    mom_y = dP21_dx + dP22_dy + dP23_dz
    
    # z-momentum
    dP31_dx = dde.grad.jacobian(y, x, i=9, j=0)
    dP32_dy = dde.grad.jacobian(y, x, i=10, j=1)
    dP33_dz = dde.grad.jacobian(y, x, i=11, j=2)
    mom_z = dP31_dx + dP32_dy + dP33_dz

    # --- Return List of Residuals ---
    # DeepXDE will square and sum these automatically
    return [
        mom_x, mom_y, mom_z,
        res_constitutive_flat[:, 0:1], res_constitutive_flat[:, 1:2], res_constitutive_flat[:, 2:3],
        res_constitutive_flat[:, 3:4], res_constitutive_flat[:, 4:5], res_constitutive_flat[:, 5:6],
        res_constitutive_flat[:, 6:7], res_constitutive_flat[:, 7:8], res_constitutive_flat[:, 8:9]
    ]

# ==============================================================================
# 2. Update Network Architecture
# ==============================================================================
# The network now needs 12 outputs instead of 3.
# [u, v, w, P11, P12, P13, P21, P22, P23, P31, P32, P33]

# Original: layer_size = [3] + [50] * 5 + [3]
# New:
layer_size = [3] + [50] * 5 + [12] 
activation = "tanh"
initializer = "Glorot uniform"
net = dde.nn.FNN(layer_size, activation, initializer)

